# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Cloudflare Workers 로컬 시크릿 (.env* 패턴에 안 걸림)
.dev.vars
.dev.vars.*
# 예시 파일은 커밋 대상 (부정 패턴은 위 패턴들보다 뒤에 와야 적용된다)
!.dev.vars.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# cloudflare / opennext 빌드 산출물 및 로컬 상태
.open-next/
.wrangler/

# 로컬 MCP 연결 설정 (실서비스 Supabase project_ref 포함 — 각자 로컬에서 관리)
.mcp.json
